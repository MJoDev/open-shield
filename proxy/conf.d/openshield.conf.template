# The protected site.
#
# Every ${OS_…} below is substituted at container start from the environment
# (§5.5) by docker-entrypoint.sh. Nothing in this file is edited by hand inside
# a running container.

server {
    listen ${OS_LISTEN_PORT} default_server;
    server_name ${OS_SERVER_NAME};

    # Written by the entrypoint only where an edge in front of the proxy is
    # trusted to carry the client's address. The glob matches nothing when it
    # is not, which nginx accepts — an empty include is not an error.
    include /etc/nginx/realip/*.conf;

    # Resolving the backend at request time rather than at startup means a
    # backend container that restarts with a new address is picked up without
    # reloading the proxy. The resolver itself comes from the container's
    # /etc/resolv.conf: Docker's embedded DNS here, the platform's elsewhere.
    resolver ${OS_RESOLVER} ipv6=${OS_RESOLVER_IPV6} valid=10s;
    set $backend_url "${OS_BACKEND_URL}";

    # The proxy's own liveness check. It is answered before the access phase, so
    # it stays up even when the engine is down — which is exactly when an
    # operator needs to know which component actually failed.
    location = /__openshield/health {
        access_log off;
        default_type application/json;
        return 200 '{"status":"ok","component":"proxy"}';
    }

    location / {
        # Every request is judged here (RF-01). See proxy/lua/openshield.lua.
        access_by_lua_block {
            require("openshield").access()
        }

        proxy_pass $backend_url$request_uri;

        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $os_forwarded_proto;
        proxy_set_header X-Request-ID      $request_id;

        # WebSocket and SSE passthrough, so a protected application that uses
        # them keeps working behind the proxy.
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        proxy_connect_timeout 5s;
        proxy_send_timeout    60s;
        proxy_read_timeout    60s;

        # The backend's own identifying headers are not forwarded to the
        # client: the point of a reverse proxy is that the origin is not
        # directly addressable.
        proxy_hide_header X-Powered-By;
        proxy_hide_header Server;
    }
}

