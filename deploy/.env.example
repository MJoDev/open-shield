# open-shield — configuration.
#
#   cp deploy/.env.example deploy/.env
#
# Every setting the system has is here (§5.5): nothing is hardcoded and nothing
# is edited by hand inside a container. Copy this file to .env and fill in the
# two secrets marked REQUIRED. .env is gitignored — never commit it.

# =============================================================================
# REQUIRED — the stack refuses to start without these
# =============================================================================

# Database password. Generate one:
#   openssl rand -base64 24
POSTGRES_PASSWORD=

# Signs dashboard session cookies. At least 32 characters. Generate one:
#   openssl rand -hex 32
#
# Changing it invalidates every open session, which is how you evict everyone
# after a suspected compromise.
OS_SESSION_SECRET=

# The dashboard administrator's password, as a bcrypt hash — never plaintext.
# Generate one with the dashboard binary itself; it prints the line to paste:
#
#   docker compose -f deploy/docker-compose.yml run --rm --no-deps \
#       --entrypoint /usr/local/bin/dashboard-api dashboard-api \
#       -hash-password 'your password here'
#
# ATTENTION: every '$' in the hash must be written '$$' here. A bcrypt hash
# begins with "$2a$10$", and Docker Compose reads '$' in this file as the start
# of a variable name — pasting the raw hash delivers an EMPTY value to the
# container, and every sign-in then fails with no useful error. The command
# above already prints the escaped form.
#
# Correct:   OS_ADMIN_PASSWORD_HASH=$$2a$$10$$N9qo8uLOickgx2ZMRZoMye...
# Broken:    OS_ADMIN_PASSWORD_HASH=$2a$10$N9qo8uLOickgx2ZMRZoMye...
OS_ADMIN_PASSWORD_HASH=

# =============================================================================
# The site being protected
# =============================================================================

# Where the proxy forwards traffic it allows. Must be reachable from the
# openshield network. Ignored by docker-compose.quickstart.yml, which points
# the proxy at its own bundled demo application.
OS_BACKEND_URL=http://demo-backend:3000

# The hostname served. '_' accepts any Host header, which is what you want
# while testing on localhost or a bare IP. Set the real domain in production.
OS_SERVER_NAME=_

# Published ports on the host.
OS_HTTP_PORT=80
OS_DASHBOARD_PORT=8081

# =============================================================================
# Behind another proxy (managed platform, CDN, load balancer)
# =============================================================================
#
# All four defaults are correct for a plain docker compose install on a VPS.
# They only need changing when something else terminates the connection before
# the proxy does — Railway, Fly, Cloud Run, Cloudflare, an ALB.

# The port OpenResty listens on inside the container. Leave it at 80 unless the
# platform assigns one; those inject PORT, which is picked up automatically, so
# setting this by hand is rarely necessary.
OS_LISTEN_PORT=80

# The DNS server nginx uses to resolve the backend at request time. Empty means
# "read the first nameserver from /etc/resolv.conf", which is Docker's embedded
# DNS under Compose and the platform's resolver elsewhere. Set it explicitly
# only to override that.
OS_RESOLVER=

# Whether that resolver may return AAAA records. Docker's embedded DNS answers
# AAAA in a way that makes nginx report the host as not found, hence 'off'.
# Turn it 'on' where the origin publishes AAAA only — a Railway private domain
# (*.railway.internal) does, and leaving this off makes every request 502.
OS_RESOLVER_IPV6=off

# Networks whose X-Forwarded-For (or OS_REAL_IP_HEADER) may be believed.
#
# Read by BOTH the proxy and the dashboard. In the proxy it decides what
# remote_addr becomes; in the dashboard it decides which address the sign-in
# throttle counts against and which one is recorded as the author of an
# administrative change in the audit chain.
#
# Empty means believe nobody: the address that actually opened the connection
# is used and the header is ignored. That is right on a VPS where clients
# connect directly, and WRONG behind a platform edge — there every request
# carries the edge's address, so ipblock and ratelimit end up keying the entire
# internet to a single IP. The failure is silent: the rules still run, they
# just protect nothing.
#
# Setting it to 0.0.0.0/0 is NOT the fix. Trusting every network means trusting
# the client, which hands an attacker a sign-in throttle they can reset at will
# by varying the header, and a forged author on every entry sealed into the
# chain. Name the edge's networks and nothing else.
#
# Space-separated CIDRs. Behind a managed platform the edge's addresses are not
# published, so '0.0.0.0/0 ::/0' is the practical setting — which makes the
# choice of header the thing that keeps it safe. See below.
OS_TRUSTED_PROXY=

# Which header carries the client's address.
#
# X-Forwarded-For is a list a client can prepend to, so trusting it from
# 0.0.0.0/0 lets an attacker forge the address an ipblock rule is keyed on.
# Prefer a header the edge overwrites and a client cannot extend:
#   Railway / Envoy  → X-Envoy-External-Address
#   Cloudflare       → CF-Connecting-IP
OS_REAL_IP_HEADER=X-Forwarded-For

# =============================================================================
# Rules engine
# =============================================================================

# Rate limit (RF-05): requests allowed per source address per window.
OS_RATELIMIT_REQUESTS=100
OS_RATELIMIT_WINDOW_S=60

# How much of a request body the sqli and xss rules inspect. Larger means more
# coverage and more work on the request path; 0 disables body inspection.
OS_MAX_BODY_INSPECT_BYTES=8192

# What the proxy does when the engine does not answer within
# OS_DECIDE_TIMEOUT_MS.
#
#   open   — let the request through, and log it. The default: a protection
#            layer that takes the site down when its own control plane blinks
#            has inverted its purpose, and §8.2 targets 99% availability.
#   closed — refuse the request with 503. Choose this where an unfiltered
#            request is worse than an unavailable one.
OS_FAIL_MODE=open
OS_DECIDE_TIMEOUT_MS=150

# Depth of the queue between the request path and the audit database. Entries
# are dropped, and counted, if it fills — never at the cost of blocking a
# request. Watch the dropped counter on the dashboard.
OS_AUDIT_BUFFER=4096

# Point at a file to override the bundled SQLi/XSS signature set without
# rebuilding the image (§8.2, periodic rule updates). Leave empty to use the
# signatures compiled into the binary.
# OS_PATTERNS_FILE=/etc/openshield/patterns.json

# =============================================================================
# Dashboard
# =============================================================================

OS_ADMIN_USER=admin

# Session lifetime, in seconds. 8 hours by default: one working day.
OS_SESSION_TTL_S=28800

# Marks the session cookie Secure, so browsers only send it over HTTPS.
# MUST stay false while the dashboard is served over plain HTTP, or signing in
# appears to succeed and then silently fails. Turn it on with TLS (v1.1).
OS_SECURE_COOKIES=false

# =============================================================================
# Infrastructure
# =============================================================================

POSTGRES_USER=openshield
POSTGRES_DB=openshield

# Redis channel carrying live decisions to the dashboard.
OS_EVENTS_CHANNEL=openshield:events

# debug | info | warn | error
OS_LOG_LEVEL=info

# Tags the built images.
OS_VERSION=dev
