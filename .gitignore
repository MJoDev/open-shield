# Secrets and local configuration
.env
deploy/.env
*.pem
*.key

# Private working material (office documents and their lock files) lives
# outside the repository; this only guards against an accidental `git add .`.
*.docx
*.doc
*.odt
*.pdf
.~lock.*#
~$*

# Go build output
/bin/
*.test
*.out

# Test artefacts written into the working directory by a run
coverage.out
load-summary.json

# Node / Vite
node_modules/
dashboard/web/dist/
dashboard/web/.vite/
*.tsbuildinfo

# The embedded copy of the built SPA is generated at image build time.
# Only the placeholder index.html is versioned (see dashboard/api/web/dist/).
dashboard/api/web/dist/*
!dashboard/api/web/dist/index.html

# Editors / OS
.DS_Store
.idea/
.vscode/
